[Unit]
Description=Yachachiq robot (web kiosk + pipeline)
# No network dependency on purpose: at the competition there is no internet, and publishing is
# store-and-forward. Waiting for network-online would leave the screen blank for up to 90 s.
After=sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/yachachiq/robot
ExecStart=/home/pi/yachachiq/robot/venv/bin/python server.py
# OpenCV probes every camera backend when a webcam is missing; keep that quiet in the journal
Environment=OPENCV_LOG_LEVEL=FATAL
Environment=OPENCV_VIDEOIO_PRIORITY_OBSENSOR=0
Restart=always
RestartSec=3
# --- overrides (uncomment / edit) ---
# Environment=YACHACHIQ_COMFYUI_URL=http://192.168.7.1:8188
# Environment=YACHACHIQ_COMFYUI_CHECKPOINT=dreamshaper_8.safetensors
# Environment=YACHACHIQ_SERIAL_PORT=/dev/ttyACM0
# Environment=YACHACHIQ_PHOTO_CAMERA=/dev/v4l/by-id/usb-XXXX-video-index0
# Environment=YACHACHIQ_WHISPER_MODEL=base
# Environment=YACHACHIQ_SPEAK_WHILE_DRAWING=0

[Install]
WantedBy=multi-user.target
