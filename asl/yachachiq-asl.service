[Unit]
Description=Yachachiq ASL keyboard (camera sign-to-text)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/yachachiq/asl
Environment=ASL_HEADLESS=1
# Uncomment and set if the wrong camera is picked up:
# Environment=ASL_CAMERA=1
ExecStart=/usr/bin/python3 /home/pi/yachachiq/asl/asl_app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
